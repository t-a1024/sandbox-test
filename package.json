{
  "name": "vscode-sandbox",
  "displayName": "VSCode Sandbox",
  "description": "A simple sandbox webview: code editor with run button, language switching, output area.",
  "version": "0.0.1",
  "publisher": "your-publisher",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:sandbox.open"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sandbox.open",
        "title": "Open Sandbox (Right Tab)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.11.9",
    "@types/vscode": "^1.70.0",
    "typescript": "^4.9.5",
    "vscode": "^0.9.9"
  }
}
